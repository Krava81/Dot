{
	"appId": "com.newsbot.manager",
	"appName": "AI News Bot",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"allowNavigation": [
			"*"
		]
	},
	"android": {
		"allowMixedContent": true,
		"webContentsDebuggingEnabled": true
	},
	"plugins": {
		"CapacitorHttp": {
			"enabled": true
		},
		"Keyboard": {
			"resize": "body"
		}
	}
}
