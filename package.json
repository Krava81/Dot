{
  "name": "ai-news-bot",
  "private": true,
  "version": "5.2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build-server": "tsc --project tsconfig.server.json",
    "build-client": "vite build",
    "build": "npm run build-server && npm run build-client",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "update-android": "npm run build && npx cap sync android",
    "generate-icons": "npx @capacitor/assets generate --android",
    "sync-from-cloud": "git add . && (git diff --cached --quiet || git commit -m \"Auto-save from cloud\") && git pull --rebase origin main && npm install --legacy-peer-deps && npm run update-android"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/browser": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/preferences": "^6.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/generative-ai": "^0.24.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/marked": "^5.0.2",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.7.9",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "easymde": "^2.20.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.2",
    "firebase-admin": "^13.7.0",
    "lucide-react": "^0.546.0",
    "markdown-it": "^14.1.1",
    "marked": "^17.0.6",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown-editor-lite": "^1.4.2",
    "react-simplemde-editor": "^5.2.0",
    "sharp": "^0.33.5",
    "telegraf": "^4.16.3",
    "tsx": "^4.21.0",
    "uuid": "^11.1.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "^6.0.2"
  }
}
